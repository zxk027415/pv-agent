      "args": [
        "-m", "pvdiag.mcp_servers.pv_data",
        "--observations", "REPO/data/scenarios/S2107-F3-0001/timeseries.parquet",
        "--metadata", "REPO/data/raw/2107/metadata/2107_system_metadata.json"
